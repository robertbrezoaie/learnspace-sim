{
  "_doc": "EXP-P, the main experiment (SIMULATION_SPEC.md section 9.2). C2 runs in all scenarios: its outcomes are identical across scenarios (plain has no gain), but the regret reference differs.",
  "N": 500,
  "S": 20,
  "T": 10,
  "seeds": { "from": 1, "to": 30 },
  "task_log_seeds": [1, 2, 3, 4, 5],
